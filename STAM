-- دوال الواجهة
-- ==========================================

local function HideToggleButton()
    ToggleBtn.Visible = false
    MainFrame.Visible = false
    RestoreBtn.Visible = true
end

local function RestoreToggleButton()
    RestoreBtn.Visible = false
    ToggleBtn.Visible = true
end

local function IsWhitelisted(playerName)
    return Whitelist[playerName] == true
end

local function ToggleWhitelist(playerName)
    if Whitelist[playerName] then
        Whitelist[playerName] = nil
    else
        Whitelist[playerName] = true
    end
    return Whitelist[playerName]
end

local function CreatePlayerButton(player)
    local btn = Instance.new("TextButton")
    btn.Name = "Btn_" .. player.Name
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Parent = ScrollFrame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, -65, 1, 0)
    nameLabel.Position = UDim2.new(0, 10, 0, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.DisplayName
    nameLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    nameLabel.Font = Enum.Font.Gotham
    nameLabel.TextSize = 13
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
    nameLabel.Parent = btn

    local statusLabel = Instance.new("TextLabel")
    statusLabel.Size = UDim2.new(0, 50, 1, 0)
    statusLabel.Position = UDim2.new(1, -55, 0, 0)
    statusLabel.BackgroundTransparency = 1
    statusLabel.Text = "إضافة"
    statusLabel.TextColor3 = Color3.fromRGB(100, 200, 100)
    statusLabel.Font = Enum.Font.GothamBold
    statusLabel.TextSize = 11
    statusLabel.Parent = btn

    if IsWhitelisted(player.Name) then
        btn.BackgroundColor3 = Color3.fromRGB(30, 60, 30)
        statusLabel.Text = "محمي ✓"
        statusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
    end

    btn.MouseButton1Click:Connect(function()
        local isNowProtected = ToggleWhitelist(player.Name)
        if isNowProtected then
            btn.BackgroundColor3 = Color3.fromRGB(30, 60, 30)
            statusLabel.Text = "محمي ✓"
            statusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
        else
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
            statusLabel.Text = "إضافة"
            statusLabel.TextColor3 = Color3.fromRGB(100, 200, 100)
        end
    end)

    return btn
end

local function RefreshPlayerList()
    for _, child in ipairs(ScrollFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            CreatePlayerButton(player)
        end
    end
end

